<?xml version='1.0' encoding='utf-8'?>
<widget id="fr.emmanuel.multicam" version="0.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>MultiCam</name>
    <description>Captation video multi-device Android sur LAN local.</description>
    <author>MultiCam</author>
    <content src="index.html" />
    <access origin="*" />
    <preference name="scheme" value="http" />
    <preference name="hostname" value="localhost" />
    <!-- J04 — trafic cleartext Android requis par ws:// LAN, déclaré de façon
         versionnée (hook after_prepare idempotent) — décision 30.10. -->
    <hook type="after_prepare" src="hooks/after_prepare/010-enable-cleartext.js" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="Orientation" value="default" />
    <platform name="android">
        <preference name="AndroidLaunchMode" value="singleTop" />
    </platform>
</widget>